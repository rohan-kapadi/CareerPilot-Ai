# ─────────────────────────────────────────────────────────────
# CareerPilot AI — client environment
# Copy to client/.env. Vite only exposes variables prefixed with VITE_.
# ─────────────────────────────────────────────────────────────

# Base URL of the Express API, including the /api prefix.
# Defaults to "/api" when unset, which works if you proxy through Vite.
#   local:      http://localhost:5000/api
#   deployed:   https://your-api-host.onrender.com/api
VITE_API_URL=http://localhost:5000/api
